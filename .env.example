APP_ENV=local
APP_DEBUG=true
APP_TIMEZONE=Africa/Cairo
APP_URL=http://localhost/LabFlow-CRM

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=labflow_crm
DB_USER=root
DB_PASSWORD=

# Per-site branding fallbacks. lab_settings values take precedence when present.
SITE_NAME=LabFlow
SITE_LOGO=assets/images/logo.jpeg
SITE_FAVICON=assets/images/favicon.svg

# Required only for the first-time super-admin setup page. Generate a random secret of 32+ characters.
ADMIN_SETUP_KEY=replace-with-a-random-secret-at-least-32-characters-long
